	<!-- Permission purpose strings (English base; localized in *.lproj/InfoPlist.strings) -->
	<key>NSCameraUsageDescription</key>
	<string>FitCheck uses the camera so you can photograph your clothes and add them to your wardrobe.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>FitCheck needs access to your photos so you can choose clothing pictures to add to your wardrobe.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>FitCheck saves the outfit images you create to your photo library.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>FitCheck uses your location to show the local weather and suggest outfits that suit it.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>FitCheck only uses your location while you are using the app, for weather-based outfit suggestions. It does not track your location in the background.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>FitCheck uses the microphone so you can ask the voice assistant for outfit suggestions.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>FitCheck uses speech recognition to understand your voice requests.</string>
	<!-- Analytics is opt-in; the app enables it only after user consent. -->
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<false/>


