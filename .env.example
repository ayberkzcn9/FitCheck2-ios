# Gemini API anahtarınızı yerel .env dosyasına ekleyin.
GEMINI_API_KEY=
GROQ_API_KEY=

# Arkaplan silme için remove.bg API key (https://remove.bg/api#getting-started)
# Ücretsiz: 50 kredi/ay
REMOVE_BG_API_KEY=

# Google ile giriş için (Firebase Konsolu → Authentication → Google →
# Web SDK yapılandırması → Web client ID). Android'de SHA-1 parmak izi
# eklendiyse boş bırakılabilir.
# NOT: Release build'lerinde kaynak daraltma (isShrinkResources) açık olduğu
# için cihaz varsayılanı olan `default_web_client_id` kaynağı silinebilir;
# bu durumda Google girişi idToken alamaz. Değeri burada açıkça vermek bu
# riski ortadan kaldırır (android/app/src/main/res/raw/keep.xml de kaynağı
# ayrıca korur).
GOOGLE_WEB_CLIENT_ID=
